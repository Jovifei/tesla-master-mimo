# AMap Web JS API credentials for the MateLink web map (see src/components/tm.tsx).
# Copy this file to .env and fill in the values from the AMap console
# (console.amap.com -> My Apps -> matelink -> the "web" key row: Key + security key).
# Keys issued after Dec 2021 need BOTH values or the map loads blank (INVALID_USER_SCODE).
# Never commit a real .env: it is git-ignored; only this template is tracked.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
