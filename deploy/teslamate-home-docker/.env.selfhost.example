# ECS 自托管（matelink-selfhost）环境变量键名清单。
#
# 用法：
#   cp .env.selfhost.example .env && chmod 600 .env
# 然后把每个占位符替换成真实值。
#
# 安全红线：
#   * 本文件只有键名与占位符，提交到 Git 是安全的；填好之后的 .env **绝不**进 Git。
#   * .env 权限必须是 600，属主 jourvolt。
#   * 任何密钥值都不得出现在聊天、日志、Obsidian、备份目录或 issue 里。
#
# 说明：docker compose 会在项目目录读取 .env 做变量插值，因此文件名必须是 .env。

# ---------------------------------------------------------------- 基础
# 容器时区。TeslaMate 的行程统计按本地时区切分，改动会影响历史分桶。
TZ=Asia/Shanghai

# ---------------------------------------------------------------- 共享 PostgreSQL
# 统一使用 alpine 变体：Debian 版镜像体积是 alpine 的 2-3 倍，1 Mbps 下能省 20-40 分钟。
#
# 版本规则（重要）：pg_dump 只能「低版本 -> 高版本」。
#   * 源库 PG18（本机家用模板用的是 postgres:18-trixie）=> 这里必须是 18。
#   * ECS 侧选高版本永远安全：它能接受任何 <= 18 的源库 dump。
#   * 若 dump-teslamate-local.sh 实测源库高于 18，则改成对应版本并重建 postgres 卷。
POSTGRES_IMAGE=postgres:18-alpine

# 共享 PostgreSQL 的超级用户 jourvolt 的密码。
# 生成方式：openssl rand -base64 32
JOURVOLT_DB_PASSWORD=replace-with-a-strong-postgres-password

# ---------------------------------------------------------------- TeslaMate
# 用于加密库里 Tesla token 的密钥。
# 走 T1② 迁移时，这一项【必须】与源端（Jovi 自己电脑上的 .env）逐字符一致，
# 否则库里的 token 解不开，TeslaMate 必须重新授权（会退回到「阻塞于备案 + 公网 443」）。
# 生成方式（仅冷启动时）：openssl rand -base64 48
TESLAMATE_ENCRYPTION_KEY=replace-with-the-source-encryption-key-or-a-new-random-one

# TeslaMate 专用角色 teslamate 的数据库密码（与超级用户密码分开）。
# 生成方式：openssl rand -base64 32
TESLAMATE_DB_PASSWORD=replace-with-a-strong-teslamate-db-password

# ---------------------------------------------------------------- API 鉴权
# MateLink App / Adapter / teslamateapi 三方共用的 API token，>= 32 字节随机值。
# 生成方式：openssl rand -base64 32
#
# R-2 兜底（先按没有 Bearer 前缀的裸 token 跑；只有 /api/v1/cars 实测返回 401 时才用）：
#   把这一项设成 `Bearer <原 token>`，让 teslamateapi 的 Authorization 比对通过。
#   注意：Adapter 侧比对的是 `Bearer ` + 本变量，因此 App 填写的 token 也要同步改，
#   且 /api/matelink/v1/* 与 /api/* 两条路径都要重新验证。
MATE_LINK_API_TOKEN=replace-with-a-long-random-api-token

# ---------------------------------------------------------------- 开关
# Adapter 是否订阅 Mosquitto 叠加实时状态（locked / doors / windows / plugged_in /
# charging_details）。true = 叠加；false = 降级到纯 PostgreSQL 快照。
MQTT_ENABLED=true

# TeslaMate 的 Phoenix origin 校验开关。
# 4000 端口不发布到宿主机，只能经 SSH 隧道直连容器 IP 访问，因此关掉校验是安全的。
# 若首次隧道登录被 origin 校验拦住，可临时设为 false；授权完成后建议改回 true。
TESLAMATE_CHECK_ORIGIN=false
