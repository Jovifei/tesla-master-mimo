# Copy this file to .env before running Docker Compose.
# Do not commit .env. It contains local secrets.

TZ=Asia/Shanghai

# Generate a long random value. TeslaMate uses it to encrypt Tesla API tokens.
TESLAMATE_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key

# Use a strong database password. Keep this identical for TeslaMate, PostgreSQL, Grafana, and TeslaMateApi.
TESLAMATE_DB_PASSWORD=replace-with-a-strong-database-password

# Optional API token for MateLink -> TeslaMateApi access.
# If you set this, enter the same token in MateLink Settings.
MATE_LINK_API_TOKEN=replace-with-a-local-api-token

# Optional personal TeslaMate -> MateLink long-term archive bridge.
# Fill these only after the cloud account has explicitly bound this source instance and vehicle.
ARCHIVE_DATABASE_URL=
ARCHIVE_URL=https://api.teslalink.joviluma.com
ARCHIVE_TOKEN=
ARCHIVE_VEHICLE_ID=
ARCHIVE_SOURCE_INSTANCE_ID=
ARCHIVE_SOURCE_VEHICLE_ID=
ARCHIVE_BATCH_SIZE=10
ARCHIVE_POLL_INTERVAL=1m
