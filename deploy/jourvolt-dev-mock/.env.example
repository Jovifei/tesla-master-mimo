# Copy to .env only after Tesla approves the JourVolt application.
# Never commit the populated .env file or paste these secrets into chat.
# For the local Mock Compose, use docker-compose.yml. For the real Pilot,
# use docker-compose.pilot.example.yml and run preflight.ps1 first.
DATABASE_URL=postgres://jourvolt:CHANGE_THIS_PASSWORD@jourvolt-postgres:5432/jourvolt?sslmode=disable
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
JOURVOLT_ENABLE_MOCK=false
JOURVOLT_ENABLE_MOCK_HISTORY=false
JOURVOLT_API_DOMAIN=api.example.com
JOURVOLT_APP_DOMAIN=auth.example.com
JOURVOLT_ACME_EMAIL=ops@example.com
# Optional static public root. Leave unset for a full repository checkout;
# generated Pilot bundles set this to ./public.
# JOURVOLT_PUBLIC_ROOT=./public
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://api.example.com/v1/auth/tesla/callback
JOURVOLT_APP_LINK_URI=https://auth.example.com/oauth/callback
# Generate 32 random bytes and store their standard Base64 representation.
JOURVOLT_TOKEN_KEY_BASE64=

# Optional official Tesla China endpoint overrides. Normally leave unset.
# TESLA_AUTH_URL=https://auth.tesla.cn/oauth2/v3/authorize
# TESLA_TOKEN_URL=https://auth.tesla.cn/oauth2/v3/token
# TESLA_ISSUER=https://auth.tesla.cn/oauth2/v3
# TESLA_JWKS_URL=https://auth.tesla.cn/oauth2/v3/discovery/keys
# TESLA_FLEET_API_BASE=https://fleet-api.prd.cn.vn.cloud.tesla.cn
