# Copy to /etc/jourvolt/backup.env and replace every placeholder before enabling timers.
# Keep the age private identity outside this file and outside the backup directory.
JOURVOLT_PILOT_ENV_FILE=/srv/jourvolt/.env
JOURVOLT_BACKUP_DIR=/srv/jourvolt-backups
JOURVOLT_BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT
JOURVOLT_BACKUP_RCLONE_REMOTE=CHANGE_THIS_RCLONE_REMOTE
RCLONE_CONFIG=/etc/jourvolt/rclone.conf
