# P1 ECS staging key list (docs/ARCH-2026-08-28-jourvolt-deploy.md 5.4 / T05).
# Copy to /home/jourvolt/jourvolt-staging/.env on the ECS host, keep mode 600,
# then fill the placeholder values IN PRIVATE. Never commit the populated file,
# never paste values into chat, Git, logs, or Obsidian.
#
# Domains and redirect URIs below are the real pilot values; only the marked
# placeholders must be filled in. TESLA_CLIENT_ID / TESLA_CLIENT_SECRET may only
# be filled by Jovi (secrets never pass through the engineer).

JOURVOLT_API_DOMAIN=api.teslalink.joviluma.com
JOURVOLT_APP_DOMAIN=auth.teslalink.joviluma.com
# ACME/certificate contact (already used for the Let's Encrypt certificates):
JOURVOLT_ACME_EMAIL=<JOVI_ACME_EMAIL>

# Public Tesla OAuth callback — must match the Tesla developer console
# registration character-for-character:
TESLA_REDIRECT_URI=https://api.teslalink.joviluma.com/v1/auth/tesla/callback
# Android App Link return URL — must match JOURVOLT_APP_DOMAIN:
JOURVOLT_APP_LINK_URI=https://auth.teslalink.joviluma.com/oauth/callback

# Pilot always runs with Mock and history fixture disabled:
JOURVOLT_ENABLE_MOCK=false
JOURVOLT_ENABLE_MOCK_HISTORY=false

# External staging PostgreSQL DSN (jourvolt-postgres alias on the
# jourvolt-staging_default docker network). PLACEHOLDER:
DATABASE_URL=postgres://jourvolt:<STAGING_POSTGRES_PASSWORD>@jourvolt-postgres:5432/jourvolt?sslmode=disable
# Only needed if a dedicated postgres container is ever started next to the
# API (docker-compose.pilot.example.yml validation path). PLACEHOLDER:
POSTGRES_PASSWORD=<STAGING_POSTGRES_PASSWORD>

# Token encryption key: `openssl rand -base64 32` — must decode to exactly
# 32 bytes (a 44-char standard Base64 string ending with '='). PLACEHOLDER:
JOURVOLT_TOKEN_KEY_BASE64=<BASE64_OF_32_RANDOM_BYTES>

# Tesla developer app credentials — LEAVE EMPTY until Jovi fills them on the
# server by hand. The API stays fail-closed (mode=unconfigured) while empty:
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# Informational base URL for public terms/privacy used by release builds and
# the download page (not consumed by the Go API process itself):
JOURVOLT_PUBLIC_INFO_BASE_URL=https://auth.teslalink.joviluma.com/

# Static root for preflight legal-page checks on the ECS bundle layout:
JOURVOLT_PUBLIC_ROOT=./public

# Docker network that hosts the external PostgreSQL. Default matches the
# current `jourvolt-staging` compose project; switch to `jourvolt-infra` after
# the ARCH 5.4 shared-instance migration:
# JOURVOLT_DB_NETWORK=jourvolt-staging_default

# Optional official Tesla China endpoint overrides. Normally leave unset.
# TESLA_AUTH_URL=https://auth.tesla.cn/oauth2/v3/authorize
# TESLA_TOKEN_URL=https://auth.tesla.cn/oauth2/v3/token
# TESLA_ISSUER=https://auth.tesla.cn/oauth2/v3/nts
# TESLA_JWKS_URL=https://auth.tesla.cn/oauth2/v3/discovery/thirdparty/keys
# TESLA_FLEET_API_BASE=https://fleet-api.prd.cn.vn.cloud.tesla.cn
