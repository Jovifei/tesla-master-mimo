{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "@tarojs/taro"],
    "paths": { "vitest": ["./test-tooling/node_modules/vitest"] }
  },
  "include": ["config", "src", "tests"]
}
