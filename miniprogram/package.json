{
  "name": "@matelink/wechat-miniprogram",
  "private": true,
  "version": "0.4.0",
  "description": "MateLink WeChat Mini Program client",
  "scripts": {
    "build:weapp": "node ../tools/miniprogram/build-vehicle-assets.mjs --check && taro build --type weapp && node ../tools/miniprogram/build-vehicle-assets.mjs --check-dist",
    "dev:weapp": "taro build --type weapp --watch",
    "test": "node --test ../tools/miniprogram/vehicle-assets-integrity.test.mjs && node test-tooling/node_modules/vitest/vitest.mjs run --config test-tooling/vitest.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tarojs/components": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "7.26.3",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "babel-preset-taro": "4.2.1",
    "typescript": "5.7.3",
    "webpack": "5.91.0",
    "react-test-renderer": "18.3.1",
    "@types/react-test-renderer": "18.3.1"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "shell-quote": "1.11.0",
    "adm-zip": "0.6.1",
    "@tarojs/components": {
      "swiper": "12.1.2"
    }
  }
}
